# secrets — never commit
.env

# node / frontend build output — never commit (a past Next.js frontend
# leaked its auto-generated Server Actions encryption key via .next/cache)
node_modules/
.next/
out/
dist/
build/

# python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# heavy / GPU-only model (regenerate with: python train_ensemble.py).
# The lightweight single model (models/fifa_model.joblib, ~1 MB, sklearn-only)
# IS committed so the app runs out of the box.
models/fifa_model_ensemble.joblib

# training scratch / logs
src/catboost_info/

# Premier League project models + plots — trained lazily on first request
# (transfer_value / match_outcome / player_scouting). Regenerate with each
# module's `python -m projects.<name>`. The player-stats CSV under
# data/players/ IS committed so the projects run out of the box.
models/projects/*.joblib
models/projects/*.png

# stale snapshot, only used as a fallback by fetch_squads_api.py
data/squads_wikipedia_backup.csv
