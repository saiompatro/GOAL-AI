# Copy to .env and fill in. .env is gitignored — never commit real keys.

# football-data.org API token — free tier at https://www.football-data.org/client/register
# Used by fetch_squads_api.py (current rosters) and tournament_form.py (live WC results).
FOOTBALL_DATA_TOKEN=

# Optional: API-Football (api-sports.io) key — free signup at https://www.api-football.com/.
# Enables live WC 2026 match statistics (shots, shots on target, possession, xG) in
# recent_stats.py. Without it, recent form falls back to scores/goals only.
API_FOOTBALL_KEY=

# Optional: Prior Labs token to activate the TabPFN ensemble member (train_ensemble.py).
# TABPFN_TOKEN=
